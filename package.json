{
  "name": "rebo-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:html": "html-validate dist/index.html",
    "format": "prettier --write .",
    "check": "npm run lint && npm run build && npm run lint:html",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "html-validate": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  },
  "lint-staged": {
    "*.{ts,js,css,html,json,md,yml}": "prettier --write",
    "*.ts": "eslint --fix"
  }
}
